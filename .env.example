# Local dev defaults. Copy to .env.local for development.
# Production values are set in Vercel's project env vars (NOT in this file).
# Required for prod: NEXT_PUBLIC_API_URL=<railway-url>; NEXT_PUBLIC_WS_URL=<wss://railway-url>/ws

# Base URL for the FastAPI backend (REST endpoints)
NEXT_PUBLIC_API_URL=http://localhost:8000

# WebSocket endpoint for real-time messaging (Phase 5+)
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws